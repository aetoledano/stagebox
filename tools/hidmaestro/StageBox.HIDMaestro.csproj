<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StageBox.HIDMaestro</AssemblyName>
    <OutputPath>../../build/hidmaestro-compiled/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HIDMaestro.Core"><HintPath>../../build/hidmaestro-sdk/HIDMaestro.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Windows.SDK.NET"><HintPath>../../build/hidmaestro-sdk/Microsoft.Windows.SDK.NET.dll</HintPath></Reference>
    <Reference Include="WinRT.Runtime"><HintPath>../../build/hidmaestro-sdk/WinRT.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
